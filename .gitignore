# biosym_projects: one .gitignore for all projects (dorschky2019, imu_uncertainty, 3d_simulations).
# Models, reference data and baselines (.osim, .xml, .yaml, .npz, .mat, .csv under data/ and models/) are tracked on
# purpose; everything below is generated, local or machine specific.

# --- Python ---------------------------------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/
pip-wheel-metadata/

# --- Environments ---------------------------------------------------------------------------------------------------
.venv/
venv/
env/
.micromamba/
.conda/
.python-version.local
.env
.env.*
!.env.example

# --- Tool caches and reports ----------------------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.hypothesis/
.ipynb_checkpoints/
.coverage
.coverage.*
coverage.xml
htmlcov/
.cache/
.jax_cache/
.biosym/

# --- Editors, OS ----------------------------------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
*.tmp
*.bak

# --- Claude Code (local settings and worktrees, not shared) ---------------------------------------------------------
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# --- Logs and solver output -----------------------------------------------------------------------------------------
*.log
*.pid
opensim.log
ipopt.out
*.stdout
*.stderr
nohup.out

# --- Containers and large binaries ----------------------------------------------------------------------------------
*.sif
*.simg
*.tar
*.tar.gz
*.zip
*.cpkl
*.pkl
*.pickle
*.h5
*.hdf5
*.ckpt
*.pt
*.pth
*.onnx

# --- Scratch, results and per-run output (regenerated by the pipelines) ---------------------------------------------
scratch/
tmp/
_trash/
*_trash/
result/
results/
reports/
logs/
output/
runs/
wandb/
lightning_logs/

# the 3d_simulations figures are the only results that are tracked (the solves behind them are not)
!3d_simulations/results/
3d_simulations/results/*
!3d_simulations/results/figure*_biosym.png
!3d_simulations/results/figure*_biosym.pdf

# variant models written by 3d_simulations/run.py
**/_models/
